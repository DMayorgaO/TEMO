POSTGRES_USER=temo
APP_ENV=development
POSTGRES_PASSWORD=temo_local_password
POSTGRES_DB=temo
POSTGRES_PORT=55432
DATABASE_URL=postgresql://temo:temo_local_password@localhost:55432/temo
DATABASE_SSL=false
# Ruta local o contenido PEM codificado en Base64 para verificar el certificado de Supabase.
DATABASE_SSL_CA_PATH=
DATABASE_SSL_CA_BASE64=
DATABASE_POOL_MAX=10
BACKEND_PORT=4000
# En proveedores como Render, PORT es asignado automaticamente.
PORT=
FRONTEND_PORT=3000
AUTH_SECRET=reemplace-con-un-secreto-largo-y-aleatorio
AUTH_TOKEN_HOURS=8
# Separar varios origenes mediante comas. Vacio permite la red local en desarrollo.
CORS_ORIGINS=
# Dejar vacio en red local para usar automaticamente el host del navegador.
VITE_API_URL=
VITE_APP_ENV=development
VITE_SESSION_IDLE_MINUTES=30
