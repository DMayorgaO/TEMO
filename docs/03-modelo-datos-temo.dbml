Project TEMO {
  database_type: 'PostgreSQL'
  Note: 'Modelo fisico de datos del Sistema de Transacciones Economicas de Miscelanea Olivera.'
}

Enum temo.accion_bitacora {
  CREAR
  ACTUALIZAR
  ANULAR
  CORREGIR
  APROBAR
  RECHAZAR
  INICIAR_SESION
  CERRAR_SESION
  IMPORTAR
}

Enum temo.alcance_cuenta {
  GLOBAL
  SUCURSAL
}

Enum temo.direccion_monto {
  ENTRA
  SALE
}

Enum temo.estado_aprobacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

Enum temo.estado_cierre {
  ABIERTO
  PENDIENTE_REVISION
  CERRADO
}

Enum temo.estado_grupo_transacciones {
  ABIERTO
  COMPLETADO
  ANULADO
}

Enum temo.estado_pendiente {
  PENDIENTE
  ABONADO
  PAGADO
  VENCIDO
  CANCELADO
}

Enum temo.estado_registro {
  ACTIVO
  INACTIVO
}

Enum temo.estado_transaccion {
  REGISTRADA
  ANULADA
  CORREGIDA
}

Enum temo.estado_turno {
  ABIERTO
  PENDIENTE_APROBACION
  CERRADO
  ANULADO
}

Enum temo.estado_usuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

Enum temo.medio_monto {
  EFECTIVO
  TRANSFERENCIA
  CREDITO
  CUENTA_BANCARIA
  AJUSTE
}

Enum temo.tipo_arqueo {
  APERTURA
  CIERRE_CALCULADO
  CIERRE_CONTADO
  AJUSTE
  TRANSACCION_RECIBIDO
  TRANSACCION_VUELTO
  TRANSACCION_ENTREGADO
  ACTUAL
  PENDIENTE_RECIBIDO
  PENDIENTE_ENTREGADO
  PENDIENTE_VUELTO
}

Enum temo.tipo_calculo_comision {
  PORCENTAJE
  FIJO
  RANGO
  MANUAL
}

Enum temo.tipo_cuenta_bancaria {
  CUENTA_REAL
  SALDO_OPERATIVO
}

Enum temo.tipo_entidad_bancaria {
  BANCO_REAL
  SERVICIO_FINANCIERO
  SERVICIO_REMESAS
  OTRO
}

Enum temo.tipo_metodo_pago {
  EFECTIVO
  TRANSFERENCIA
  CREDITO
  MIXTO
}

Enum temo.tipo_pendiente {
  POR_COBRAR
  POR_PAGAR
}

Enum temo.tipo_tasa_aplicada {
  COMPRA
  VENTA
}

Table temo.abonos_pendientes [headercolor: #8A5A00] {
  id_abono uuid [pk, default: `gen_random_uuid()`]
  id_pendiente uuid [not null]
  id_transaccion uuid [not null]
  id_moneda uuid [not null]
  monto decimal(16,4) [not null]
  fecha_abono timestamptz [not null, default: `now()`]
  id_usuario_creacion uuid [not null]
  observaciones text
  id_turno_aplicacion uuid
  id_tipo_cambio uuid
  tasa_compra_usada decimal(14,6)
  tasa_venta_usada decimal(14,6)
  Note: 'Liquidaciones parciales o totales aplicadas a una cuenta pendiente.'
}

Table temo.anulaciones_transacciones [headercolor: #8A5A00] {
  id_anulacion uuid [pk, default: `gen_random_uuid()`]
  id_transaccion uuid [unique, not null]
  id_usuario uuid [not null]
  fecha_anulacion timestamptz [not null, default: `now()`]
  motivo text [not null]
}

Table temo.aprobaciones [headercolor: #9F1239] {
  id_aprobacion uuid [pk, default: `gen_random_uuid()`]
  id_usuario_solicitud uuid [not null]
  id_usuario_revision uuid
  entidad varchar(80) [not null]
  id_entidad_registro uuid [not null]
  estado temo.estado_aprobacion [not null, default: 'PENDIENTE']
  fecha_solicitud timestamptz [not null, default: `now()`]
  fecha_revision timestamptz
  motivo text
  observaciones_revision text
}

Table temo.arqueos [headercolor: #1D4ED8] {
  id_arqueo uuid [pk, default: `gen_random_uuid()`]
  id_turno uuid
  id_jornada uuid
  id_caja uuid
  tipo temo.tipo_arqueo [not null]
  id_moneda uuid [not null]
  monto_total decimal(16,4) [not null, default: 0]
  id_usuario_creacion uuid [not null]
  fecha_creacion timestamptz [not null, default: `now()`]
  observaciones text
  id_grupo_transacciones uuid
  id_tipo_cambio uuid
  tipo_tasa temo.tipo_tasa_aplicada
  tasa_usada decimal(14,6)
  monto_esperado decimal(16,4)
  diferencia decimal(16,4)
  id_abono_pendiente uuid
}

Table temo.arqueos_denominaciones [headercolor: #1D4ED8] {
  id_arqueo_denominacion uuid [pk, default: `gen_random_uuid()`]
  id_arqueo uuid [not null]
  id_denominacion uuid [not null]
  cantidad int [not null]
  monto decimal(16,4) [not null]
  montones_25 int [not null, default: 0]
  sueltos int [not null, default: 0]

  indexes {
    (id_arqueo, id_denominacion) [unique, name: 'uq_arqueos_denominaciones']
  }
}

Table temo.bitacora [headercolor: #9F1239] {
  id_bitacora uuid [pk, default: `gen_random_uuid()`]
  id_usuario uuid
  id_dispositivo uuid
  accion temo.accion_bitacora [not null]
  tabla varchar(80) [not null]
  id_registro uuid
  datos_anteriores jsonb
  datos_nuevos jsonb
  direccion_ip inet
  agente_usuario text
  fecha_creacion timestamptz [not null, default: `now()`]
}

Table temo.cajas [headercolor: #176B5B] {
  id_caja uuid [pk, default: `gen_random_uuid()`]
  id_sucursal uuid [not null]
  codigo varchar(30) [not null]
  nombre varchar(120) [not null]
  estado temo.estado_registro [not null, default: 'ACTIVO']
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]

  indexes {
    (id_sucursal, codigo) [unique, name: 'uq_cajas_sucursal_codigo']
  }
}

Table temo.cierres_diarios [headercolor: #1D4ED8] {
  id_cierre_diario uuid [pk, default: `gen_random_uuid()`]
  id_jornada uuid [not null]
  id_sucursal uuid
  id_usuario_cierre uuid [not null]
  estado temo.estado_cierre [not null, default: 'PENDIENTE_REVISION']
  total_comisiones_nio decimal(16,4) [not null, default: 0]
  total_comisiones_usd decimal(16,4) [not null, default: 0]
  observaciones text
  fecha_cierre timestamptz [not null, default: `now()`]

  indexes {
    (id_jornada, id_sucursal) [unique, name: 'uq_cierres_diarios_alcance']
  }
}

Table temo.cierres_diarios_detalles [headercolor: #1D4ED8] {
  id_cierre_detalle uuid [pk, default: `gen_random_uuid()`]
  id_cierre_diario uuid [not null]
  id_moneda uuid [not null]
  total_efectivo_calculado decimal(16,4) [not null, default: 0]
  total_efectivo_contado decimal(16,4) [not null, default: 0]
  total_cuentas_calculado decimal(16,4) [not null, default: 0]
  total_pendientes decimal(16,4) [not null, default: 0]
  total_comisiones decimal(16,4) [not null, default: 0]
  diferencia decimal(16,4) [not null, default: 0]

  indexes {
    (id_cierre_diario, id_moneda) [unique, name: 'uq_cierre_detalle_moneda']
  }
}

Table temo.contrapartes [headercolor: #176B5B] {
  id_contraparte uuid [pk, default: `gen_random_uuid()`]
  nombre varchar(160) [not null]
  tipo varchar(40) [not null, default: 'CLIENTE_PROVEEDOR']
  telefono varchar(40)
  observaciones text
  estado temo.estado_registro [not null, default: 'ACTIVO']
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]

  indexes {
    (nombre, tipo) [unique, name: 'uq_contrapartes_nombre_tipo']
  }
}

Table temo.correcciones_transacciones [headercolor: #8A5A00] {
  id_correccion uuid [pk, default: `gen_random_uuid()`]
  id_transaccion_original uuid [not null]
  id_transaccion_correccion uuid [unique, not null]
  id_usuario uuid [not null]
  fecha_correccion timestamptz [not null, default: `now()`]
  motivo text [not null]
}

Table temo.cuentas_bancarias [headercolor: #176B5B] {
  id_cuenta uuid [pk, default: `gen_random_uuid()`]
  id_entidad uuid [not null]
  id_moneda uuid [not null]
  id_sucursal uuid
  tipo_cuenta temo.tipo_cuenta_bancaria [not null, default: 'CUENTA_REAL']
  alcance temo.alcance_cuenta [not null, default: 'GLOBAL']
  consecutivo int [not null]
  alias varchar(80) [unique, not null]
  numero_cuenta varchar(80)
  estado temo.estado_registro [not null, default: 'ACTIVO']
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]

  indexes {
    (id_entidad, id_moneda, consecutivo) [unique, name: 'uq_cuentas_entidad_moneda_consecutivo']
  }
}

Table temo.cuentas_movimientos [headercolor: #176B5B] {
  id_cuenta_movimiento uuid [pk, default: `gen_random_uuid()`]
  id_cuenta uuid [not null]
  id_movimiento uuid [not null]
  codigo_operativo varchar(40) [not null]
  nombre_operativo varchar(180) [not null]
  prioridad int [not null, default: 100]
  estado temo.estado_registro [not null, default: 'ACTIVO']
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]

  indexes {
    (id_cuenta, codigo_operativo) [unique, name: 'uq_cuentas_codigo_operativo']
    (id_cuenta, id_movimiento) [unique, name: 'uq_cuentas_movimientos']
  }
}

Table temo.cuentas_sucursales [headercolor: #176B5B] {
  id_cuenta uuid [not null]
  id_sucursal uuid [not null]
  fecha_creacion timestamptz [not null, default: `now()`]

  indexes {
    (id_cuenta, id_sucursal) [pk, name: 'cuentas_sucursales_pkey']
  }
}

Table temo.denominaciones [headercolor: #176B5B] {
  id_denominacion uuid [pk, default: `gen_random_uuid()`]
  id_moneda uuid [not null]
  valor decimal(14,2) [not null]
  etiqueta varchar(40) [not null]
  orden int [not null, default: 0]
  estado temo.estado_registro [not null, default: 'ACTIVO']

  indexes {
    (id_moneda, valor) [unique, name: 'uq_denominaciones_moneda_valor']
  }
}

Table temo.directorio_cedulas {
  id_cedula uuid [pk, default: `gen_random_uuid()`]
  id_destinatario uuid [not null]
  numero varchar(20) [not null]
  titular varchar(180)
  orden smallint [not null, default: 1]
  fecha_creacion timestamptz [not null, default: `now()`]

  indexes {
    (id_destinatario, numero) [unique, name: 'directorio_cedulas_id_destinatario_numero_key']
  }
}

Table temo.directorio_destinatarios {
  id_destinatario uuid [pk, default: `gen_random_uuid()`]
  codigo_destinatario bigint [unique, not null]
  nombre varchar(180) [not null]
  observaciones text
  estado temo.estado_registro [not null, default: 'ACTIVO']
  id_usuario_creacion uuid
  id_usuario_modificacion uuid
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]
}

Table temo.directorio_fuentes_importacion {
  id_fuente uuid [pk, default: `gen_random_uuid()`]
  id_destinatario uuid [not null]
  hoja varchar(120) [not null]
  fila int [not null]
  datos_originales jsonb [not null, default: '[]']
  fecha_importacion timestamptz [not null, default: `now()`]

  indexes {
    (id_destinatario, hoja, fila) [unique, name: 'directorio_fuentes_importacion_id_destinatario_hoja_fila_key']
  }
}

Table temo.directorio_identificadores {
  id_identificador uuid [pk, default: `gen_random_uuid()`]
  id_destinatario uuid [not null]
  institucion varchar(100) [not null, default: '']
  tipo varchar(100) [not null]
  numero varchar(100) [not null]
  id_moneda uuid
  orden smallint [not null, default: 1]
  fecha_creacion timestamptz [not null, default: `now()`]

  indexes {
    (id_destinatario, institucion, tipo, numero) [unique, name: 'directorio_identificadores_id_destinatario_institucion_tipo_key']
  }
}

Table temo.directorio_referencias {
  id_referencia uuid [pk, default: `gen_random_uuid()`]
  id_destinatario uuid [not null]
  referencia varchar(180) [not null]
  orden smallint [not null, default: 1]
  fecha_creacion timestamptz [not null, default: `now()`]

  indexes {
    (id_destinatario, referencia) [unique, name: 'directorio_referencias_id_destinatario_referencia_key']
  }
}

Table temo.dispositivos [headercolor: #17324D] {
  id_dispositivo uuid [pk, default: `gen_random_uuid()`]
  id_usuario uuid
  nombre_dispositivo varchar(120)
  huella_dispositivo varchar(255) [unique]
  direccion_ip inet
  agente_usuario text
  primera_vez timestamptz [not null, default: `now()`]
  ultima_vez timestamptz [not null, default: `now()`]
}

Table temo.efectos_movimientos [headercolor: #176B5B] {
  id_efecto uuid [pk, default: `gen_random_uuid()`]
  id_cuenta_movimiento uuid [unique, not null]
  afecta_efectivo boolean [not null, default: true]
  direccion_efectivo temo.direccion_monto
  afecta_cuenta boolean [not null, default: true]
  direccion_cuenta temo.direccion_monto
  genera_pendiente boolean [not null, default: false]
  tipo_pendiente temo.tipo_pendiente
  requiere_contraparte boolean [not null, default: false]
  permite_conversion boolean [not null, default: false]
  permite_credito boolean [not null, default: false]
  observaciones text
}

Table temo.entidades_bancarias [headercolor: #176B5B] {
  id_entidad uuid [pk, default: `gen_random_uuid()`]
  codigo varchar(30) [unique, not null]
  nombre_corto varchar(40) [not null]
  nombre_largo varchar(180) [not null]
  tipo temo.tipo_entidad_bancaria [not null]
  mostrar_como_banco boolean [not null, default: true]
  maneja_saldo boolean [not null, default: true]
  maneja_comision boolean [not null, default: true]
  estado temo.estado_registro [not null, default: 'ACTIVO']
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]
}

Table temo.grupos_transacciones [headercolor: #8A5A00] {
  id_grupo_transacciones uuid [pk, default: `gen_random_uuid()`]
  codigo_operacion bigint [unique, not null]
  id_turno uuid [not null]
  id_contraparte uuid
  estado temo.estado_grupo_transacciones [not null, default: 'ABIERTO']
  id_tipo_cambio_vuelto uuid
  tipo_tasa_vuelto temo.tipo_tasa_aplicada
  tasa_vuelto_usada decimal(14,6)
  observaciones text
  id_usuario_creacion uuid [not null]
  id_usuario_modificacion uuid
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]
  Note: 'Encabezado atomico para una o varias transacciones realizadas por el mismo cliente.'
}

Table temo.historial_pendientes [headercolor: #8A5A00] {
  id_historial uuid [pk, default: `gen_random_uuid()`]
  id_pendiente uuid [not null]
  estado_anterior temo.estado_pendiente
  estado_nuevo temo.estado_pendiente [not null]
  id_usuario uuid [not null]
  fecha_cambio timestamptz [not null, default: `now()`]
  motivo text
}

Table temo.importaciones_excel [headercolor: #9F1239] {
  id_importacion uuid [pk, default: `gen_random_uuid()`]
  nombre_archivo text [not null]
  ruta_archivo text
  fecha_detectada date
  sucursal_detectada varchar(120)
  id_sucursal_asignada uuid
  id_caja_asignada uuid
  id_cajero_asignado uuid
  estado varchar(40) [not null, default: 'PENDIENTE']
  id_usuario_importacion uuid
  fecha_importacion timestamptz [not null, default: `now()`]
  observaciones text
}

Table temo.importaciones_excel_errores [headercolor: #9F1239] {
  id_importacion_error uuid [pk, default: `gen_random_uuid()`]
  id_importacion_fila uuid
  id_importacion uuid [not null]
  codigo_error varchar(80) [not null]
  mensaje text [not null]
  fecha_creacion timestamptz [not null, default: `now()`]
}

Table temo.importaciones_excel_filas [headercolor: #9F1239] {
  id_importacion_fila uuid [pk, default: `gen_random_uuid()`]
  id_importacion uuid [not null]
  hoja varchar(80) [not null]
  numero_fila int [not null]
  datos_crudos jsonb [not null]
  id_transaccion_mapeada uuid
  estado_validacion varchar(40) [not null, default: 'PENDIENTE']
  fecha_creacion timestamptz [not null, default: `now()`]
}

Table temo.jornadas [headercolor: #1D4ED8] {
  id_jornada uuid [pk, default: `gen_random_uuid()`]
  fecha date [not null]
  id_sucursal uuid
  id_usuario_apertura uuid [not null]
  id_usuario_cierre uuid
  estado temo.estado_cierre [not null, default: 'ABIERTO']
  fecha_apertura timestamptz [not null, default: `now()`]
  fecha_cierre timestamptz
  observaciones text

  indexes {
    (fecha, id_sucursal) [unique, name: 'uq_jornadas_fecha_sucursal']
  }
}

Table temo.metodos_pago [headercolor: #176B5B] {
  id_metodo_pago uuid [pk, default: `gen_random_uuid()`]
  codigo varchar(40) [unique, not null]
  nombre varchar(80) [not null]
  tipo temo.tipo_metodo_pago [not null]
  estado temo.estado_registro [not null, default: 'ACTIVO']
}

Table temo.migraciones_sistema [headercolor: #9F1239] {
  codigo varchar(80) [pk]
  fecha_aplicacion timestamptz [not null, default: `now()`]
}

Table temo.monedas [headercolor: #176B5B] {
  id_moneda uuid [pk, default: `gen_random_uuid()`]
  codigo char [unique, not null]
  nombre varchar(80) [not null]
  simbolo varchar(8) [not null]
  decimales smallint [not null, default: 2]
  estado temo.estado_registro [not null, default: 'ACTIVO']
}

Table temo.movimientos [headercolor: #176B5B] {
  id_movimiento uuid [pk, default: `gen_random_uuid()`]
  codigo varchar(40) [unique, not null]
  nombre varchar(160) [not null]
  descripcion text
  estado temo.estado_registro [not null, default: 'ACTIVO']
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]
}

Table temo.movimientos_cuentas [headercolor: #8A5A00] {
  id_movimiento_cuenta uuid [pk, default: `gen_random_uuid()`]
  id_transaccion uuid
  id_cuenta uuid [not null]
  id_moneda uuid [not null]
  direccion temo.direccion_monto [not null]
  monto decimal(16,4) [not null]
  es_reverso boolean [not null, default: false]
  id_movimiento_reversado uuid
  fecha_creacion timestamptz [not null, default: `now()`]
  id_transferencia uuid
}

Table temo.movimientos_efectivo [headercolor: #8A5A00] {
  id_movimiento_efectivo uuid [pk, default: `gen_random_uuid()`]
  id_transaccion uuid
  id_turno uuid [not null]
  id_caja uuid [not null]
  id_moneda uuid [not null]
  direccion temo.direccion_monto [not null]
  monto decimal(16,4) [not null]
  es_reverso boolean [not null, default: false]
  id_movimiento_reversado uuid
  fecha_creacion timestamptz [not null, default: `now()`]
  id_grupo_transacciones uuid
  id_abono_pendiente uuid
  id_transferencia uuid
}

Table temo.notificaciones_usuarios [headercolor: #9F1239] {
  id_notificacion uuid [pk, default: `gen_random_uuid()`]
  id_usuario_destino uuid [not null]
  tipo varchar(40) [not null]
  titulo varchar(160) [not null]
  mensaje text [not null]
  id_pendiente uuid
  id_turno uuid
  id_usuario_origen uuid
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_lectura timestamptz
}

Table temo.pagos_pendientes [headercolor: #8A5A00] {
  id_pendiente uuid [pk, default: `gen_random_uuid()`]
  id_transaccion uuid [unique, not null]
  tipo temo.tipo_pendiente [not null]
  id_contraparte uuid [not null]
  id_moneda uuid [not null]
  monto_original decimal(16,4) [not null]
  saldo_pendiente decimal(16,4) [not null]
  fecha_vencimiento date
  estado temo.estado_pendiente [not null, default: 'PENDIENTE']
  observaciones text
  id_usuario_creacion uuid [not null]
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]
}

Table temo.permisos [headercolor: #17324D] {
  id_permiso uuid [pk, default: `gen_random_uuid()`]
  codigo varchar(80) [unique, not null]
  nombre varchar(120) [not null]
  descripcion text
  estado temo.estado_registro [not null, default: 'ACTIVO']
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_modificacion timestamptz [not null, default: `now()`]
}

Table temo.reglas_comisiones [headercolor: #176B5B] {
  id_comision uuid [pk, default: `gen_random_uuid()`]
  id_entidad uuid [not null]
